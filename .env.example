# Скопируйте в .env и заполните. Файл .env не публикуйте и не коммитьте.

# Домен сайта (без www — www.<домен> перенаправляется сюда) и почта для уведомлений Let's Encrypt о сроке сертификата
DOMAIN=akniet-home.kg
LETSENCRYPT_EMAIL=

# Вход в админку /admin (basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# PostgreSQL (наружу не открыта, доступна только backend)
POSTGRES_DB=akniet
POSTGRES_USER=akniet
POSTGRES_PASSWORD=change-me

# Telegram-бот: пусто — заглушка, заявки сохраняются только в БД
# TOKEN — от @BotFather, CHAT_ID — чат менеджеров, куда бот присылает заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет webhook для кнопок «Беру»/«Готово»; можно оставить пустым — тогда он выводится из токена
TELEGRAM_WEBHOOK_SECRET=

# SEO. Адрес сайта для canonical / sitemap; пусто — https://DOMAIN
SITE_URL=
# Коды подтверждения: Google Search Console и Яндекс.Вебмастер (только значение content из их meta-тега)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# Аналитика: Google Analytics 4 (G-XXXXXXX) и номер счётчика Яндекс.Метрики. Пусто — не подключается
GA4_ID=
YANDEX_METRIKA_ID=

# Порты на хосте (для локальной проверки можно поставить 8080 / 8443)
HTTP_PORT=80
HTTPS_PORT=443
